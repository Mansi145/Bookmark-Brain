# Copy to backend/.env and fill in. Never commit .env.
DATABASE_URL=postgresql+asyncpg://bb:bb@localhost:5432/bookmark_brain
FRONTEND_ORIGIN=http://localhost:5173

# Phase 1: auth
JWT_SECRET=change-me-run-openssl-rand-hex-32
GOOGLE_CLIENT_ID=
# prod only: SESSION_COOKIE_SECURE=true and SESSION_COOKIE_SAMESITE=none

# Background job worker (runs inside the API). false = API only.
WORKER_ENABLED=true

# Phase 2+: AI
GOOGLE_API_KEY=
GROQ_API_KEY=
# Optional extra fallbacks (free): https://openrouter.ai/keys and https://build.nvidia.com
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# Optional: override the models (defaults in app/config.py)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
# GROQ_MODEL=openai/gpt-oss-120b
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=bookmark-brain
AI_DAILY_LIMIT_PER_USER=50

# Phase 7: cron endpoints
INTERNAL_CRON_SECRET=
